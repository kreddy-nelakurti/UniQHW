	)
	(text_box "Operation\n• Signals from either side are automatically translated.\n• Pull-up resistors define the logic HIGH voltage on each bus.\n• Supports two-way communication without MCU intervention."
		(exclude_from_sim no)
		(at 173.99 300.99 0)
		(size 55.88 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
