		)
		(uuid "df57a4e0-1030-4dfe-a777-5ea202605d03")
	)
	(text_box "he MCU runs at 3.3V, the modem runs at 1.8V, so every signal crossing between them needs a translator. U17 handles UART, U18 handles modem status lines (RI/DSR/DCD/DTR), U19 handles audio sync/clock signals, U20 handles wake/safe-power-remove/headphone-detec."
		(exclude_from_sim no)
