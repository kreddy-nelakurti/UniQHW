		)
		(uuid "509bf7f0-4393-493c-b781-acff12fd92b9")
	)
	(text_box "a dedicated I2C-specific level shifter, not just a generic buffer. I2C needs this because it's open-drain and bidirectional (both sides can pull the line low), which a plain shifter like the TXU parts can't handle correctly."
		(exclude_from_sim no)
		(at 173.99 271.78 0)
